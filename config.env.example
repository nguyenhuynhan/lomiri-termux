# Chạy trong Termux. Dự án nằm ở ~/projects/lomiri-termux.
LOMIRI_DISTRO=lomiri-debian
LOMIRI_USER=dev
LOMIRI_DISPLAY=:1
# Dùng render bằng CPU để kiểm chứng trước; chưa tối ưu GPU.
LOMIRI_SOFTWARE_RENDERING=1
# Local QtMir input bridge; rebuild after Qt/QtMir upgrades.
LOMIRI_MOUSE_COMPAT=1
LOMIRI_INPUT_TRACE=0
# Tested PRoot VSCode needs --no-sandbox; opt in explicitly after evaluating it.
LOMIRI_CODE_NO_SANDBOX=0
